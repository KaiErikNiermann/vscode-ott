{
    "name": "vscode-vscode-ott",
    "description": "Language support for the Ott specification language",
    "version": "0.0.6",
    "displayName": "vscode-ott",
    "publisher": "KaiErikNiermann",
    "license": "MIT",
    "icon": "icon.png",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/KaiErikNiermann/vscode-ott"
    },
    "homepage": "https://github.com/KaiErikNiermann/vscode-ott#readme",
    "bugs": {
        "url": "https://github.com/KaiErikNiermann/vscode-ott/issues"
    },
    "engines": {
        "vscode": "^1.110.0"
    },
    "categories": [
        "Programming Languages",
        "Formatters",
        "Linters"
    ],
    "keywords": [
        "ott",
        "programming languages",
        "semantics",
        "type systems",
        "langium"
    ],
    "contributes": {
        "languages": [
            {
                "id": "ott",
                "aliases": [
                    "Ott",
                    "ott"
                ],
                "extensions": [
                    ".ott"
                ],
                "configuration": "./language-configuration.json",
                "icon": {
                    "light": "./icons/ott-rule-light.svg",
                    "dark": "./icons/ott-rule-dark.svg"
                }
            }
        ],
        "grammars": [
            {
                "language": "ott",
                "scopeName": "source.ott",
                "path": "syntaxes/ott.tmLanguage.json"
            }
        ],
        "configuration": {
            "title": "Ott",
            "properties": {
                "ott.project.profile": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Which `Ott.toml` profile to resolve symbols against. Empty uses the default `[spec] files` list. A file that the active profile does not include falls back to the union of every source set that does contain it, so it is never left without cross-file symbols."
                },
                "ott.project.features": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "markdownDescription": "Feature names from `Ott.toml` to append to the resolved source list, as `ott build --features` would."
                }
            }
        }
    },
    "activationEvents": [
        "onLanguage:ott",
        "workspaceContains:**/*.ott"
    ],
    "main": "./out/extension/main.cjs",
    "scripts": {
        "clean": "shx rm -fr *.tsbuildinfo out syntaxes icons",
        "vscode:prepublish": "pnpm run build",
        "build:prepare": "shx mkdir -p ./syntaxes/ && shx cp -f ../language/syntaxes/ott.tmLanguage.json ./syntaxes/ott.tmLanguage.json && shx cp -f ../../assets/icon.png ./icon.png && shx mkdir -p ./icons/ && shx cp -f ../../assets/file-icons/ott-rule-light.svg ../../assets/file-icons/ott-rule-dark.svg ./icons/ && shx cp -f ../../LICENSE ./LICENSE",
        "build": "pnpm run build:prepare && tsc -b tsconfig.json && node esbuild.mjs",
        "build:clean": "pnpm run clean && pnpm run build",
        "package": "pnpm dlx @vscode/vsce package --no-dependencies --out ../..",
        "watch": "pnpm run build:prepare && concurrently -n tsc,esbuild -c blue,yellow \"tsc -b tsconfig.json --watch\" \"node esbuild.mjs --watch\""
    },
    "dependencies": {
        "ott-language": "workspace:*",
        "langium": "~4.3.1",
        "vscode-languageclient": "~10.0.1",
        "vscode-languageserver": "~10.0.1"
    },
    "devDependencies": {
        "@types/node": "~26.4.1",
        "@types/vscode": "~1.110.0",
        "concurrently": "~10.0.5",
        "esbuild": "~0.28.2"
    },
    "vsce": {
        "dependencies": false
    }
}
